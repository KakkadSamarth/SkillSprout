# SkillSprout Environment Variables for Vercel Deployment

# 1. Cloud MySQL Database Credentials
# (Compatible with TiDB Cloud, Aiven, Railway, PlanetScale, AWS RDS, Supabase MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=workpoint
DB_PORT=3306
DB_SSL=false

# Alternative: Single Database Connection URL (if provided by your cloud host)
# DATABASE_URL=mysql://user:password@host:3306/workpoint

# 2. Application Base URL
# Set to '/' for Vercel root deployment, or '/SkillSprout/' for local XAMPP
BASE_URL=/

# 3. Session Driver
# Automatically set to database on Vercel
SESSION_DRIVER=database
