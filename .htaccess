<IfModule mod_rewrite.c>
RewriteEngine On

Options -Indexes

RewriteRule ^auth/?$ auth/login.php [L,QSA]
RewriteRule ^user/?$ user/dashboard.php [L,QSA]
RewriteRule ^tasks/?$ tasks/tasks.php [L,QSA]

RewriteRule ^login\.php$ auth/login.php [L,QSA]
RewriteRule ^register\.php$ auth/register.php [L,QSA]
RewriteRule ^logout\.php$ auth/logout.php [L,QSA]

RewriteRule ^dashboard\.php$ user/dashboard.php [L,QSA]
RewriteRule ^my_work\.php$ user/my_work.php [L,QSA]
RewriteRule ^wallet\.php$ user/wallet.php [L,QSA]
RewriteRule ^purchase_wallet\.php$ user/purchase_wallet.php [L,QSA]
RewriteRule ^purchase_points\.php$ user/purchase_wallet.php [L,QSA]
RewriteRule ^profile\.php$ user/profile.php [L,QSA]

RewriteRule ^tasks\.php$ tasks/tasks.php [L,QSA]
RewriteRule ^create_task\.php$ tasks/create_task.php [L,QSA]
RewriteRule ^task_details\.php$ tasks/task_details.php [L,QSA]
RewriteRule ^apply_task\.php$ tasks/apply_task.php [L,QSA]
RewriteRule ^manage_applications\.php$ tasks/manage_applications.php [L,QSA]
RewriteRule ^submit_work\.php$ tasks/submit_work.php [L,QSA]
RewriteRule ^review_submission\.php$ tasks/review_submission.php [L,QSA]
RewriteRule ^cancel_task\.php$ tasks/cancel_task.php [L,QSA]

RewriteRule ^about$ about.php [L,QSA]
RewriteRule ^home$ index.php [L,QSA]

RewriteRule ^login$ auth/login.php [L,QSA]
RewriteRule ^register$ auth/register.php [L,QSA]
RewriteRule ^logout$ auth/logout.php [L,QSA]

RewriteRule ^dashboard$ user/dashboard.php [L,QSA]
RewriteRule ^my[-_]work$ user/my_work.php [L,QSA]
RewriteRule ^wallet$ user/wallet.php [L,QSA]
RewriteRule ^purchase[-_]wallet$ user/purchase_wallet.php [L,QSA]
RewriteRule ^purchase[-_]points$ user/purchase_wallet.php [L,QSA]
RewriteRule ^buy[-_]points$ user/purchase_wallet.php [L,QSA]
RewriteRule ^profile$ user/profile.php [L,QSA]

RewriteRule ^create[-_]task$ tasks/create_task.php [L,QSA]
RewriteRule ^task[-_]details$ tasks/task_details.php [L,QSA]
RewriteRule ^apply[-_]task$ tasks/apply_task.php [L,QSA]
RewriteRule ^manage[-_]applications$ tasks/manage_applications.php [L,QSA]
RewriteRule ^submit[-_]work$ tasks/submit_work.php [L,QSA]
RewriteRule ^review[-_]submission$ tasks/review_submission.php [L,QSA]
RewriteRule ^cancel[-_]task$ tasks/cancel_task.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

</IfModule>
